if(!is.null(ta())){
glimpse(missing_entries() %>% summarise(waldkontakte = 100 * sum(habitat == "Wald")/n()))
paste0("Abbildung 1: Darstellung der Verteilung der Kontakte und Gesamtzahl der Tiere
in den verschiedenen Habitaten. Die Verteilung über die Habitate (insbesondere die Verteilung Wald vs. Offenland)
bildet die Grundlage für die Wahl der Parameter zur Erfassungsrate. Bei der gewählten Fahrt sind ",
(round(missing_entries() %>% summarise(waldkontakte = 100 * sum(habitat != "Wald")/n()), 1))$waldkontakte,
" % aller Kontakte im Offenland erfolgt und ",
(round(missing_entries() %>% summarise(gesamtzahl = 100 * sum(gesamtzahl[habitat != "Wald"])/sum(gesamtzahl)), 1))$gesamt,
" % des Rotwilds wurde im Offenland gezählt. Ein höherer Anteil an Offenlandbeobachtungen weist auf höhere Erfassungsraten hin.")
}
})
output$plotB <- renderPlot({
if(!is.null(ta())){
plotB()
}
})
output$textPlotB <- renderText("Abbildung 2 :  Darstellung der tatsächlich gezählten Klassen,
sowie der daraus abgeleiteten Zuordnung der Klassen für Beobachtungen die ledigdlich
als Rotwild oder Kahlwildrudel identifiziert werden konnten. Aus der abgeleiteten Zuordnung
erfolgt die Hochrechnung anhand der angenommenen Erfassungsrate. Die Unsicherheit wird hier
als 25 - 75 % Konfidenzintervall angegeben.")
output$plotC <- renderPlot({
if(!is.null(ta())){
plotC()
}
})
output$textPlotC <- renderText(paste0("Abbildung 3:  Schätzung des Zuwachses der weiblichen Tieren
für den Sommer des Beobachtungsjahres anhand der Hochrechnung der Einzelklassen (AT, ST, K_w) sowie unter Annahme eines
Zuwachsfaktors (", input$growth[1], " bis ", input$growth[2], ")"))
output$plotD <- renderPlot({
if(!is.null(ta())){
plotD()
}
})
output$textPlotD <- renderText(paste0(
"Abbildung 4: Dichteschätzung anhand der errechneten Bestände. Es wurden ", round(mean(estimation() %>% as_tibble() %>% select(AT, ST, K_w) %>% rowSums())), " Stück weibliches Rotwild und ",  round(mean(estimation() %>% as_tibble() %>% select(K_m, SP, III, II, I, M) %>% rowSums())) ," Stück männliches Rotwild gezählt. Der schwarze Balken gibt die sich daraus ergebende Dichte an. ",
" Daraus und anhand der gewählten Parameter zur Erfassungsrate wurden im Mittel ", round(mean(hochrechnung_maennlich()$m_ist_bestand)), " Stück männliches Rotwild und ",
round(mean(hochrechnung_weiblich()$w_ist_bestand)), " Stück weibliches Rotwild errechnet. Die Wahrscheinlichkeitsverteilung der hochgerechneten Dichte (Boxplot) ist in Grün dargestellt. Die Dichte ergibt sich anhand der gezählten bzw. hochgerechneten Bestandesgröße und der befahrenen Fläche."))
output$download <- downloadHandler(
filename = function() {
paste("output", "zip", sep=".")
},
content = function(file){
#owd <- setwd(tempdir())
#on.exit(setwd(owd))
file.remove(list.files("download", full.names = T))
file.remove("download")
dir.create(here("download"))
p1 <- plotA()
p2 <- plotB()
p3 <- plotC()
p4 <- plotD()
plot_text <- paste0("Grafik: automatisch erstellt, NLPHH, ", Sys.Date())
logo <- nlpColor::getLogo(inverse = input$dark_mode, darkBackground = input$dark_mode)
for(plot_nr in 1:4){
pl <- get(paste0("p", plot_nr))
the_plot <-  nlpColor::addLogo(pl,
logo,
text = plot_text,
darkBackground = input$dark_mode,
logo_size = .2)
ggsave(here("download", paste0(input$fahrt, "_", LETTERS[plot_nr], ".png")), plot = the_plot, device = "png", width = 16*2, height = 10.2*2, units = "cm")
}
files <- list.files(path = "download", full.names = T)
print(files)
zip::zip(file, files)
}#,
# contentType = "application/zip"
)
}
