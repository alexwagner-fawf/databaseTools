db_con <- function(driver = RPostgres::Postgres(),
port = 5432,
dbname = "forschung",
host = "10.82.152.222"){
if(Sys.getenv("DBTools_db_user") == ""){
register_environ(db_user = readline("User missing for connect, enter it, to set it in the current environment"),
db_pw = Sys.getenv("DBTools_db_pw"))
}
if(Sys.getenv("DBTools_db_pw") == ""){
message("Password missing for connect, enter it, to set it in the current environment")
register_environ(db_user = Sys.getenv("DBTools_db_user"),
db_pw = getPass::getPass())
}
con <- tryCatch({
DBI::dbConnect(drv = driver,
port = port,
dbname = dbname,
host = host,
user = Sys.getenv("DBTools_db_user"),
password = Sys.getenv("DBTools_db_pw"))
},
error = function(e){
warning("Error when trying to establish connection.
Check credentials and default values in databaseTools::db_con.
Run register_environ() to set username and password.")
return(invisible(FALSE))
})
}
db_con()
