#' @param db character object, name of the database
#' @param dbSchema character object, name of the database scheme
#' @param dbTable character object, name of the database table
#' @param geomName character object, name of the geometry column in the database table, if NA - non-spatial Data is assumed
#' @param uploadRaster raster or spatRaster object
#' @param overwriteTable boolean, whether to overwrite the existing table
#' @return Nothing
#' @export
#'
#'
uploadRaster <- function(uploadRaster, dbSchema, dbTable, db = "forschung", geomName = "geometry", overwriteTable = F){
driver<- RPostgreSQL::PostgreSQL()
db.con <- DBI::dbConnect(drv = driver, port = 5432,  dbname = db,
host = "10.82.152.222", user = "fsadmin", qwertz())
if(rpostgis::pgPostGIS(db.con)){
permission <- requestPermission(db.con, dbTable, overwriteTable)
if(permission){
if (dim(spatRas)[3] > 1) {
rpostgis::pgWriteRast(db.con,
c(dbSchema, dbTable),
raster::stack(uploadRaster),
overwrite = overwriteTable)
}else{
rpostgis::pgWriteRast(db.con,
c(dbSchema, dbTable),
raster::raster(uploadRaster),
overwrite = overwriteTable)
}
}else{
message("Invalid password, aborted the process before uploading!")
}
RPostgreSQL::dbDisconnect(db.con)
}else{
message("Postgis extension is missing!")
}
RPostgreSQL::dbDisconnect(db.con)
}
