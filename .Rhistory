register_environ <- function(db_user = NULL,
db_pw = getPass::getPass(noblank = TRUE),
test_connection = TRUE,
...){
prev_db_user <- Sys.getenv("DBTools_db_user")
prev_db_pw <- Sys.getenv("DBTools_db_pw")
while(is.null(db_user) | is.null(db_pw)){
if(is.null(db_user)){
readline("User missing for connect, enter it, to set it in the current environment: ")
}
if(is.null(db_pw)){
readline("User missing for connect, enter it, to set it in the current environment: ")
}
}
Sys.setenv("DBTools_db_user" = db_user)
Sys.setenv("DBTools_db_pw" = db_pw)
if(test_connection){
con <- db_con(...)
if(S3Class(con) == "logical"){
Sys.setenv("DBTools_db_user" = prev_db_user)
Sys.setenv("DBTools_db_pw" = prev_db_pw)
stop("connection credentials not valid. check username and password and pass driver, port, dbname and host (see db_con function)")
}else{
DBI::dbDisconnect(con)
message("Connection settings valid! :-)")
}
}
}
